│   │   │   ├── view/\n│   │   │   │   ├── ad_section.dart\n│   │   │   │   ├── language_item.dart\n│   │   │   │   └── language_selection_screen.dart\n│   │   │   └── view_model/\n│   │   │       └── language_view_model.dart\n│   │   ├── trending_avatars/\n│   │   │   ├── model/\n│   │   │   │   └── avatar_model.dart\n│   │   │   ├── view/\n│   │   │   │   ├── trending_avatars_screen.dart\n│   │   │   │   └── widgets/\n│   │   │   │       ├── avatar_preview.dart\n│   │   │   │       ├── categories_tabs.dart\n│   │   │   │       ├── promotion_banner.dart\n│   │   │   │       └── trending_section.dart\n│   │   │   └── view_model/\n│   │   │       └── avatar_view_model.dart\n│   │   └── upload/\n│   │       ├── models/\n│   │       │   └── photo_model.dart\n│   │       ├── upload_module.dart\n│   │       ├── utils/\n│   │       ├── views/\n│   │       │   ├── components/\n│   │       │   │   └── photo_grid.dart\n│   │       │   └── upload_screen.dart\n│   │       └── view_models/\n│   │           └── upload_view_model.dart\n│   └── utils/\n├── linux/\n│   ├── CMakeLists.txt\n│   ├── flutter/\n│   │   ├── CMakeLists.txt\n│   │   ├── ephemeral/\n│   │   │   └── .plugin_symlinks/\n│   │   │       ├── file_selector_linux/\n│   │   │       │   ├── AUTHORS\n│   │   │       │   ├── CHANGELOG.md\n│   │   │       │   ├── example/\n│   │   │       │   │   ├── lib/\n│   │   │       │   │   │   ├── get_directory_page.dart\n│   │   │       │   │   │   ├── get_multiple_directories_page.dart\n│   │   │       │   │   │   ├── home_page.dart\n│   │   │       │   │   │   ├── main.dart\n│   │   │       │   │   │   ├── open_image_page.dart\n│   │   │       │   │   │   ├── open_multiple_images_page.dart\n│   │   │       │   │   │   ├── open_text_page.dart\n│   │   │       │   │   │   └── save_text_page.dart\n│   │   │       │   │   ├── linux/\n│   │   │       │   │   │   ├── CMakeLists.txt\n│   │   │       │   │   │   ├── flutter/\n│   │   │       │   │   │   │   ├── CMakeLists.txt\n│   │ 