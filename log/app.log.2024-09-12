import 'package:flutter/material.dart';
import '../constants/colors.dart';
import '../constants/strings.dart';
import '../constants/styles.dart';
import '../widgets/feature_option_widget.dart';
import '../widgets/next_button_widget.dart';

class FeatureSelectionScreen extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: <Widget>[
            Padding(
              padding: const EdgeInsets.fromLTRB(16.0, 24.0, 16.0, 16.0),
              child: Text(
                AppStrings.title,
                textAlign: TextAlign.center,
                style: AppStyles.titleTextStyle,
              ),
            ),
            Expanded(
              child: SingleChildScrollView(
                child: Column(
                  children: [
                    FeatureOptionWidget(
                      title: 'AI Art',
                      subtitle: 'Elevate your pictures with advanced face swapping.',
                      icon: Icons.brush,
                      borderColor: AppColors.blue,
                      onTap: () {
                        // Add navigation functionality here
                        print('AI Art selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'AI Enhance',
                      subtitle: 'Enhance your image quality.',
                      icon: Icons.enhance_photo_translate,
                      onTap: () {
                        print('AI Enhance selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'AI Avatar',
                      subtitle: 'Transform your selfie into diverse avatar styles.',
                      icon: Icons.person_pin,
                      onTap: () {
                        print('AI Avatar selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'Text to Image',
                      subtitle: 'Turn text into personalized avatars.',
                      icon: Icons.text_fields,
                      onTap: () {
                        print('Text to Image selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'Face Me',
                      subtitle: 'Lorem Ipsum is simply dummy text.',
                      icon: Icons.face,
                      onTap: () {
                        print('Face Me selected');
                      },
                    ),
                  ],
                ),
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(16.0),
              child: NextButtonWidget(
                onPressed: () {
                  // Navigate to next screen
                  print('Next button pressed');
                },
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(16.0),
              child: Column(
                children: [
                  Container(
                    height: 50,
                    decoration: BoxDecoration(
                      color: AppColors.grey300,
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Center(child: Text(AppStrings.ad)),
                  ),
                  SizedBox(height: 8.0),
                  Text(AppStrings.loading),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
```

#### `widgets/feature_option_widget.dart`
Enhance the widget to handle tap events.

```dart
import 'package:flutter/material.dart';
import '../constants/colors.dart';
import '../constants/styles.dart';

class FeatureOptionWidget extends StatelessWidget {
  final String title;
  final String subtitle;
  final IconData icon;
  final Color borderColor;
  final VoidCallback? onTap;

  FeatureOptionWidget({
    required this.title,
    required this.subtitle,
    required this.icon,
    this.borderColor = AppColors.transparent,
    this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        margin: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),
        decoration: BoxDecoration(
          color: AppColors.white,
          borderRadius: BorderRadius.circular(10.0),
          border: Border.all(
            color: borderColor,
            width: borderColor == AppColors.transparent ? 0 : 2,
          ),
        ),
        child: ListTile(
          contentPadding: EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),
          leading: Container(
            padding: const EdgeInsets.all(6.0),
            decoration: BoxDecoration(
              color: AppColors.grey200,
              borderRadius: BorderRadius.circular(10.0),
            ),
            child: Icon(
              icon,
              size: 36,
              color: borderColor == AppColors.transparent
                  ? AppColors.black
                  : AppColors.blue,
            ),
          ),
          title: Text(
            title,
            style: AppStyles.featureTitleTextStyle,
          ),
          subtitle: Text(
            subtitle,
            style: AppStyles.featureSubtitleTextStyle,
          ),
        ),
      ),
    );
  }
}
```

#### `widgets/next_button_widget.dart`
Allow the `Next` button to handle press events.

```dart
import 'package:flutter/material.dart';
import '../constants/strings.dart';
import '../constants/styles.dart';

class NextButtonWidget extends StatelessWidget {
  final VoidCallback? onPressed;

  NextButtonWidget({this.onPressed});

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: double.infinity,
      height: 48,
      child: ElevatedButton(
        style: AppStyles.nextButtonStyle,
        onPressed: onPressed,
        child: Text(AppStrings.next),
      ),
    );
  }
}
```

