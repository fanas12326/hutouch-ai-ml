2. **Define Colors and Styles**:
   - Define the colors and text styles based on the Figma data.

3. **Create Reusable Components**:
   - Create a reusable widget for the feature list items to avoid repetition.
   - Create a reusable widget for the button.
   - Create a reusable widget for the ad section.

4. **Layout the Main Screen**:
   - Use a `Column` widget to organize the UI components vertically.
   - Include Positioned widgets to accurately place the elements based on the Figma coordinates.

5. **Add Components to the Main Screen**:
   - Add the header text.
   - Add the feature list items.
   - Add the "Next" button.
   - Add the ad section.

### Code Implementation:

```dart
import 'package:flutter/material.dart';

// Define colors
const Color borderColor = Color.fromRGBO(235, 245, 255, 1);
const Color shadowColor = Color.fromRGBO(0, 0, 0, 0.03);
const Color textColorPrimary = Color.fromRGBO(73, 76, 97, 1);
const Color textColorSecondary = Color.fromRGBO(120, 124, 152, 1);
const Color buttonColor = Color.fromRGBO(1, 129, 253, 1);
const Color buttonTextColor = Color.fromRGBO(255, 255, 255, 1);

// Function to create a reusable feature list item widget
Widget featureItem({
  required String title,
  required String description,
  required IconData icon,
  bool hasBorder = false,
  required double topPadding,
  required double height,
}) {
  return Container(
    margin: EdgeInsets.symmetric(horizontal: 16.0, vertical: topPadding),
    padding: EdgeInsets.all(16.0),
    decoration: BoxDecoration(
      color: Colors.white,
      border: hasBorder ? Border.all(color: borderColor) : null,
      borderRadius: BorderRadius.circular(8.0),
      boxShadow: [
        BoxShadow(
          color: shadowColor,
          blurRadius: 8,
          offset: Offset(0, 4),
        )
      ],
    ),
    height: height,
    child: Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              title,
              style: TextStyle(
                fontFamily: 'Proxima Nova',
                fontSize: 14,
                fontWeight: FontWeight.bold,
                color: textColorPrimary,
              ),
            ),
            SizedBox(height: 4.0),
            Text(
              description,
              style: TextStyle(
                fontFamily: 'Proxima Nova',
                fontSize: 14,
                fontWeight: FontWeight.normal,
                color: textColorSecondary,
              ),
            ),
          ],
        ),
        Icon(icon),
      ],
    ),
  );
}

// Function to create a reusable button widget
Widget nextButton({
  required String text,
  required void Function() onPressed,
  required double topPadding,
}) {
  return Container(
    margin: EdgeInsets.symmetric(horizontal: 16.0, vertical: topPadding),
    width: double.infinity,
    height: 48.0,
    child: ElevatedButton(
      style: ElevatedButton.styleFrom(
        primary: buttonColor, // Set background color
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(8.0),
        ),
      ),
      onPressed: onPressed,
      child: Text(
        text,
        style: TextStyle(
          fontFamily: 'Proxima Nova',
          fontSize: 16,
          fontWeight: FontWeight.bold,
          color: buttonTextColor,
        ),
      ),
    ),
  );
}

// Function to create a reusable ad section
Widget adPlaceholder({
  required double topPadding,
}) {
  return Container(
    margin: EdgeInsets.symmetric(horizontal: 16.0, vertical: topPadding),
    padding: EdgeInsets.all(16.0),
    width: double.infinity,
    height: 164.0,
    color: Colors.grey[200],
    child: Center(
      child: Text(
        "Loading...",
        style: TextStyle(
          fontFamily: 'Proxima Nova',
          fontSize: 14,
          fontWeight: FontWeight.normal,
          color: textColorSecondary,
        ),
      ),
    ),
  );
}

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: Scaffold(
        appBar: AppBar(
          backgroundColor: Colors.white,
          shadowColor: Colors.transparent,
        ),
        body: SafeArea(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Padding(
                padding: EdgeInsets.all(16.0),
                child: Text(
                  "Which features do you like the most?",
                  style: TextStyle(
                    fontFamily: 'Proxima Nova',
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    color: textColorPrimary,
                  ),
                ),
              ),
              featureItem(
                title: "AI Art",
                description: "Elevate your pictures with advanced face swapping.",
                icon: Icons.star,
                hasBorder: true,
                topPadding: 0.0,
                height: 77.0,
              ),
              featureItem(
                title: "AI Enhance",
                description: "Enhance your image quality",
                icon: Icons.edit,
                hasBorder: false,
                topPadding: 8.0,
                height: 60.0,
              ),
              featureItem(
                title: "AI Avatar",
                description: "Transform your selfie into diverse avatar styles",
                icon: Icons.person,
                hasBorder: false,
                topPadding: 8.0,
                height: 77.0,
              ),
              featureItem(
                title: "Text to Image",
                description: "Turn text into personalized avatars",
                icon: Icons.article,
                hasBorder: false,
                topPadding: 8.0,
                height: 60.0,
              ),
              featureItem(
                title: "Face Me",
                description: "Lorem Ipsum is simply dummy text.",
                icon: Icons.timer,
                hasBorder: false,
                topPadding: 8.0,
                height: 60.0,
              ),
              nextButton(
                text: "Next",
                onPressed: () {},
                topPadding: 16.0,
              ),
              adPlaceholder(
                topPadding: 16.0,
              ),
            ],
          ),
        ),
      ),
    );
  }
}
```

- The `featureItem` widget is reused for each feature item with varying properties.
- The `nextButton` is a reusable widget to avoid repetition.
- The `adPlaceholder` is also a reusable widget to maintain consistency.
- The main screen layout is organized within a `Column` to align elements vertically.

This structured and component-based approach ensures code reusability and clean design.
