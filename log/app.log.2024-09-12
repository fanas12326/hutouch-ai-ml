    return Container(
      margin: EdgeInsets.only(bottom: 16), // Spacing for home indicator
      child: Center(
        child: Container(
          width: 100,
          height: 5,
          decoration: BoxDecoration(
            color: Colors.black,
            borderRadius: BorderRadius.circular(2.5),
          ),
        ),
      ),
    );
  }
}
