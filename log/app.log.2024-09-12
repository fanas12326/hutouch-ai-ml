```dart
import 'package:flutter/material.dart';

// Define colors
const Color borderColor = Color.fromRGBO(1, 129, 253, 1);
const Color shadowColor = Color.fromRGBO(0, 0, 0, 0.03);
const Color textColorPrimary = Color.fromRGBO(47, 46, 65, 1);
const Color textColorSecondary = Color.fromRGBO(120, 120, 155, 1);
const Color buttonColor = Color.fromRGBO(1, 129, 253, 1);
const Color buttonTextColor = Color.fromRGBO(255, 255, 255, 1);
const Color iconBackgroundColor = Color.fromRGBO(1, 129, 253, 1);

// Function to create a reusable feature list item widget
Widget featureItem({
  required String title,
  required String description,
  required IconData icon,
  required bool hasBorder,
}) {
  return Container(
    margin: EdgeInsets.symmetric(horizontal: 16.0),
    padding: EdgeInsets.all(16.0),
    decoration: BoxDecoration(
      color: Colors.white,
      border: hasBorder ? Border.all(color: borderColor) : null,
      borderRadius: BorderRadius.circular(8.0),
      boxShadow: [
        BoxShadow(
          color: shadowColor,
          blurRadius: 8,
          offset: Offset(0, 4),
        )
      ],
    ),
    child: Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              title,
              style: TextStyle(
                fontFamily: 'Proxima Nova',
                fontSize: 14,
                fontWeight: FontWeight.bold,
                color: textColorPrimary,
              ),
            ),
            SizedBox(height: 4.0),
            Text(
              description,
              style: TextStyle(
                fontFamily: 'Proxima Nova',
                fontSize: 12,
                fontWeight: FontWeight.normal,
                color: textColorSecondary,
              ),
            ),
          ],
        ),
        Container(
          padding: EdgeInsets.all(8.0),
          decoration: BoxDecoration(
            color: iconBackgroundColor.withOpacity(0.1),
            borderRadius: BorderRadius.circular(8.0),
          ),
          child: Icon(
            icon,
            color: iconBackgroundColor,
          ),
        ),
      ],
    ),
  );
}

// Function to create a reusable button widget
Widget nextButton({
  required String text,
  required void Function() onPressed,
}) {
  return Container(
    margin: EdgeInsets.symmetric(horizontal: 16.0, vertical: 16.0),
    width: double.infinity,
    height: 48.0,
    child: ElevatedButton(
      style: ElevatedButton.styleFrom(
        primary: buttonColor, // Set background color
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(8.0),
        ),
      ),
      onPressed: onPressed,
      child: Text(
        text,
        style: TextStyle(
          fontFamily: 'Proxima Nova',
          fontSize: 16,
          fontWeight: FontWeight.bold,
          color: buttonTextColor,
        ),
      ),
    ),
  );
}

// Function to create a reusable ad section
Widget adPlaceholder() {
  return Container(
    margin: EdgeInsets.symmetric(horizontal: 16.0, vertical: 16.0),
    padding: EdgeInsets.all(16.0),
    width: double.infinity,
    height: 164.0,
    decoration: BoxDecoration(
      color: Colors.grey[200],
      borderRadius: BorderRadius.circular(8.0),
    ),
    child: Center(
      child: Text(
        "Loading...",
        style: TextStyle(
          fontFamily: 'Proxima Nova',
          fontSize: 14,
          fontWeight: FontWeight.normal,
          color: textColorSecondary,
        ),
      ),
    ),
  );
}

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: Scaffold(
        appBar: AppBar(
          backgroundColor: Colors.white,
          shadowColor: Colors.transparent,
        ),
        body: SafeArea(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Padding(
                padding: EdgeInsets.all(16.0),
                child: Text(
                  "Which features do you like the most?",
                  style: TextStyle(
                    fontFamily: 'Proxima Nova',
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    color: textColorPrimary,
                  ),
                ),
              ),
              featureItem(
                title: "AI Art",
                description: "Elevate your pictures with advanced face swapping.",
                icon: Icons.star,
                hasBorder: true,
              ),
              SizedBox(height: 8.0),
              featureItem(
                title: "AI Enhance",
                description: "Enhance your image quality",
                icon: Icons.edit,
                hasBorder: false,
              ),
              SizedBox(height: 8.0),
              featureItem(
                title: "AI Avatar",
                description: "Transform your selfie into diverse avatar styles",
                icon: Icons.person,
                hasBorder: false,
              ),
              SizedBox(height: 8.0),
              featureItem(
                title: "Text to Image",
                description: "Turn text into personalized avatars",
                icon: Icons.article,
                hasBorder: false,
              ),
              SizedBox(height: 8.0),
              featureItem(
                title: "Face Me",
                description: "Lorem Ipsum is simply dummy text.",
                icon: Icons.timer,
                hasBorder: false,
              ),
              nextButton(
                text: "Next",
                onPressed: () {},
              ),
              adPlaceholder(),
            ],
          ),
        ),
      ),
    );
  }
}
```

