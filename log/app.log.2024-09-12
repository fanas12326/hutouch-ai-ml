```dart
import 'package:flutter/material.dart';
import '../constants/app_colors.dart';
import '../constants/app_text_styles.dart';

class FeatureItem extends StatefulWidget {
  final String title;
  final String description;
  final IconData icon;
  final bool hasBorder;

  FeatureItem({
    required this.title,
    required this.description,
    required this.icon,
    required this.hasBorder,
  });

  @override
  _FeatureItemState createState() => _FeatureItemState();
}

class _FeatureItemState extends State<FeatureItem> {
  bool isStarred = false;

  void toggleStar() {
    setState(() {
      isStarred = !isStarred;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: EdgeInsets.symmetric(horizontal: 16.0),
      padding: EdgeInsets.all(16.0),
      decoration: BoxDecoration(
        color: Colors.white,
        border: widget.hasBorder ? Border.all(color: AppColors.borderColor) : null,
        borderRadius: BorderRadius.circular(8.0),
        boxShadow: [
          BoxShadow(
            color: AppColors.shadowColor,
            blurRadius: 8,
            offset: Offset(0, 4),
          )
        ],
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(widget.title, style: AppTextStyles.title),
              SizedBox(height: 4.0),
              Text(widget.description, style: AppTextStyles.description),
            ],
          ),
          GestureDetector(
            onTap: toggleStar,
            child: Container(
              padding: EdgeInsets.all(8.0),
              decoration: BoxDecoration(
                color: widget.icon == Icons.star ? (isStarred ? AppColors.iconBackgroundColor : AppColors.iconBackgroundColor.withOpacity(0.1)) : AppColors.iconBackgroundColor.withOpacity(0.1),
                borderRadius: BorderRadius.circular(8.0),
              ),
              child: Icon(
                widget.icon,
                color: widget.icon == Icons.star ? (isStarred ? Colors.yellow : AppColors.iconBackgroundColor) : AppColors.iconBackgroundColor,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
```

#### 6. **widgets/next_button.dart**
Remain unchanged.

#### 7. **widgets/ad_placeholder.dart**
Remain unchanged.

This restructuring retains the original UI and structure while integrating the specific functionality of the `Star` icon. The star icon will now glow when pressed and revert to its normal state when pressed again.
