#### `main.dart`

```dart
import 'package:flutter/material.dart';
import 'screens/feature_selection_screen.dart';

// Entry point of the application
void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: FeatureSelectionScreen(), // Setting FeatureSelectionScreen as the home screen
    );
  }
}
```

#### `constants/colors.dart`

```dart
import 'package:flutter/material.dart';

// Centralized Color Constants
class AppColors {
  static const Color blue = Colors.blue;
  static const Color white = Colors.white;
  static const Color grey300 = Colors.grey[300]!;
  static const Color black = Colors.black;
  static const Color grey200 = Colors.grey[200]!;
}
```

#### `constants/strings.dart`

```dart
// Centralized String Constants
class AppStrings {
  static const String title = 'Which features do you like the most?';
  static const String next = 'Next';
  static const String ad = 'AD';
  static const String loading = 'Loading...';
}
```

#### `constants/styles.dart`

```dart
import 'package:flutter/material.dart';
import 'colors.dart';

// Centralized Style Constants
class AppStyles {
  static final TextStyle titleTextStyle = TextStyle(
    fontSize: 18,
    fontWeight: FontWeight.bold,
  );

  static final TextStyle featureTitleTextStyle = TextStyle(
    fontSize: 16,
    fontWeight: FontWeight.bold,
  );

  static final TextStyle featureSubtitleTextStyle = TextStyle(
    fontSize: 14,
  );

  static final ButtonStyle nextButtonStyle = ElevatedButton.styleFrom(
    primary: AppColors.blue,
    onPrimary: AppColors.white,
  );
}
```

#### `screens/feature_selection_screen.dart`

```dart
import 'package:flutter/material.dart';
import '../constants/colors.dart';
import '../constants/strings.dart';
import '../constants/styles.dart';
import '../widgets/feature_option_widget.dart';
import '../widgets/next_button_widget.dart';

class FeatureSelectionScreen extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: <Widget>[
            // Title Text
            Padding(
              padding: const EdgeInsets.fromLTRB(16.0, 24.0, 16.0, 16.0),
              child: Text(
                AppStrings.title,
                textAlign: TextAlign.center,
                style: AppStyles.titleTextStyle,
              ),
            ),
            // Feature Options
            Expanded(
              child: SingleChildScrollView(
                child: Column(
                  children: [
                    // Individual Feature Options with Tap Functionality
                    FeatureOptionWidget(
                      title: 'AI Art',
                      subtitle: 'Elevate your pictures with advanced face swapping.',
                      icon: Icons.brush,
                      borderColor: AppColors.blue,
                      onTap: () {
                        // Logging the selection
                        print('AI Art selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'AI Enhance',
                      subtitle: 'Enhance your image quality.',
                      icon: Icons.enhance_photo_translate,
                      onTap: () {
                        print('AI Enhance selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'AI Avatar',
                      subtitle: 'Transform your selfie into diverse avatar styles.',
                      icon: Icons.person_pin,
                      onTap: () {
                        print('AI Avatar selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'Text to Image',
                      subtitle: 'Turn text into personalized avatars.',
                      icon: Icons.text_fields,
                      onTap: () {
                        print('Text to Image selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'Face Me',
                      subtitle: 'Lorem Ipsum is simply dummy text.',
                      icon: Icons.face,
                      onTap: () {
                        print('Face Me selected');
                      },
                    ),
                  ],
                ),
              ),
            ),
            // Next Button with Navigation Functionality
            Padding(
              padding: const EdgeInsets.all(16.0),
              child: NextButtonWidget(
                onPressed: () {
                  // Logging the button press
                  print('Next button pressed');
                },
              ),
            ),
            // Advertisement Section
            Padding(
              padding: const EdgeInsets.all(16.0),
              child: Column(
                children: [
                  Container(
                    height: 50,
                    decoration: BoxDecoration(
                      color: AppColors.grey300,
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Center(child: Text(AppStrings.ad)),
                  ),
                  SizedBox(height: 8.0),
                  Text(AppStrings.loading),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
```

#### `widgets/feature_option_widget.dart`

```dart
import 'package:flutter/material.dart';
import '../constants/colors.dart';
import '../constants/styles.dart';

class FeatureOptionWidget extends StatelessWidget {
  final String title;
  final String subtitle;
  final IconData icon;
  final Color borderColor;
  final VoidCallback? onTap;

  // Constructor to initialize properties
  FeatureOptionWidget({
    required this.title,
    required this.subtitle,
    required this.icon,
    this.borderColor = AppColors.transparent,
    this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        margin: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),
        decoration: BoxDecoration(
          color: AppColors.white,
          borderRadius: BorderRadius.circular(10.0),
          border: Border.all(
            color: borderColor,
            width: borderColor == AppColors.transparent ? 0 : 2,
          ),
        ),
        child: ListTile(
          contentPadding: EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),
          leading: Container(
            padding: const EdgeInsets.all(6.0),
            decoration: BoxDecoration(
              color: AppColors.grey200,
              borderRadius: BorderRadius.circular(10.0),
            ),
            child: Icon(
              icon,
              size: 36,
              color: borderColor == AppColors.transparent
                  ? AppColors.black
                  : AppColors.blue,
            ),
          ),
          title: Text(
            title,
            style: AppStyles.featureTitleTextStyle,
          ),
          subtitle: Text(
            subtitle,
            style: AppStyles.featureSubtitleTextStyle,
          ),
        ),
      ),
    );
  }
}
```

#### `widgets/next_button_widget.dart`

```dart
import 'package:flutter/material.dart';
import '../constants/strings.dart';
import '../constants/styles.dart';

// A Custom Button Widget for 'Next' Button
class NextButtonWidget extends StatelessWidget {
  final VoidCallback? onPressed;

  // Constructor to initialize the onPressed event
  NextButtonWidget({this.onPressed});

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: double.infinity,
      height: 48,
      child: ElevatedButton(
        style: AppStyles.nextButtonStyle,
        onPressed: onPressed,
        child: Text(AppStrings.next),
      ),
    );
  }
}
```

#### `utils/error_handling.dart`

```dart
// Simple error handling utility function
void handleError(Object error) {
  print('An error occurred: $error');
  // Additional error handling logic can be added here
}
