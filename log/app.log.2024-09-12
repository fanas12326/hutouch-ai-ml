                child: Column(
                  children: [
                    FeatureOptionWidget(
                      title: 'Feature 1',
                      subtitle: 'Description of feature 1.',
                      icon: Icons.featured_play_list,
                      borderColor: AppColors.grey200,
                      onTap: () {
                        print('Feature 1 selected');
                      },
                    ),
                    FeatureOptionWidget(
                      title: 'Feature 2',
                      subtitle: 'Description of feature 2.',
                      icon: Icons.featured_video,
                      onTap: () {
                        print('Feature 2 selected');
                      },
                    ),
                  ],
                ),
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(16.0),
              child: NextButtonWidget(
                onPressed: () {
                  // Define the next action here
                  print('Proceed from new screen');
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
