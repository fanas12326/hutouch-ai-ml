### Widgets

**lib/widgets/feature_item.dart**

```dart
import 'package:flutter/material.dart';
import '../constants/app_colors.dart';
import '../constants/app_text_styles.dart';

class FeatureItem extends StatefulWidget {
  final String title;
  final String description;
  final IconData icon;
  final bool hasBorder;

  FeatureItem({
    required this.title,
    required this.description,
    required this.icon,
    required this.hasBorder,
  });

  @override
  _FeatureItemState createState() => _FeatureItemState();
}

class _FeatureItemState extends State<FeatureItem> {
  bool isStarred = false;

  void toggleStar() {
    setState(() {
      isStarred = !isStarred;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: widget.hasBorder ? EdgeInsets.fromLTRB(16.0, 6.0, 16.0, 6.0) : EdgeInsets.symmetric(horizontal: 16.0, vertical: 4.0),
      padding: EdgeInsets.all(16.0),
      decoration: BoxDecoration(
        color: Colors.white,
        border: widget.hasBorder ? Border.all(color: AppColors.borderColor) : null,
        borderRadius: BorderRadius.circular(8.0),
        boxShadow: [
          BoxShadow(
            color: AppColors.shadowColor,
            blurRadius: 8,
            offset: Offset(0, 4),
          ),
        ],
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(widget.title, style: AppTextStyles.title),
                SizedBox(height: 4.0),
                Text(widget.description, style: AppTextStyles.description),
              ],
            ),
          ),
          GestureDetector(
            onTap: widget.icon == Icons.star ? toggleStar : null,
            child: Container(
              padding: EdgeInsets.all(8.0),
              decoration: BoxDecoration(
                color: widget.icon == Icons.star
                    ? (isStarred ? AppColors.iconBackgroundColor : AppColors.iconBackgroundColor.withOpacity(0.1))
                    : AppColors.iconBackgroundColor.withOpacity(0.1),
                borderRadius: BorderRadius.circular(8.0),
              ),
              child: Icon(
                widget.icon,
                color: widget.icon == Icons.star ? (isStarred ? Colors.yellow : AppColors.iconBackgroundColor) : AppColors.iconBackgroundColor,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
```

**lib/widgets/next_button.dart**

```dart
import 'package:flutter/material.dart';
import '../constants/app_colors.dart';
import '../constants/app_text_styles.dart';

class NextButton extends StatelessWidget {
  final String text;
  final void Function() onPressed;

  NextButton({
    required this.text,
    required this.onPressed,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: EdgeInsets.fromLTRB(16.0, 16.0, 16.0, 0),
      width: double.infinity,
      height: 48.0,
      child: ElevatedButton(
        style: ElevatedButton.styleFrom(
          primary: AppColors.buttonColor, // Set background color
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(8.0),
          ),
        ),
        onPressed: onPressed,
        child: Text(text, style: AppTextStyles.button),
      ),
    );
  }
}
```

**lib/widgets/ad_placeholder.dart**

```dart
import 'package:flutter/material.dart';
import '../constants/app_colors.dart';
import '../constants/app_text_styles.dart';

class AdPlaceholder extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Container(
      margin: EdgeInsets.fromLTRB(16.0, 16.0, 16.0, 32.0),
      padding: EdgeInsets.all(16.0),
      width: double.infinity,
      height: 164.0,
      decoration: BoxDecoration(
        color: AppColors.adBackgroundColor,
        borderRadius: BorderRadius.circular(8.0),
      ),
      child: Center(
        child: Text("Loading...", style: AppTextStyles.adLoading),
      ),
    );
  }
}
```

### Summary of Changes:
1. **Constants:** Created separate files for color and text styles to centralize common design tokens.
2. **Main Entry Point:** Updated routing to include new screens.
3. **Home Screen:** Modified to navigate to the new screen on button press.
4. **New Screen:** Created to provide new features as specified.
5. **Widgets:** Ensured widgets are reusable and properly styled to match the provided design.

This updated code ensures the new screen functionality is integrated seamlessly while maintaining the original UI and structure, adhering to the coding standards and enhancing the app's functionality.
