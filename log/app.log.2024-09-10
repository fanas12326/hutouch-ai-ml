2024-09-10 21:35:07,210 - root - INFO - [{'file_path': 'call_controller.dart', 'content': "import 'package:get/get.dart';\r\n\r\nclass CallController extends GetxController {\r\n  var recentCalls = <String>[].obs;\r\n  var allCalls = <String>[].obs;\r\n  \r\n  void addCall(String call) {\r\n    // Add a call to the list of all calls and recent calls\r\n    allCalls.add(call);\r\n    recentCalls.add(call);\r\n  }\r\n\r\n  void sortCalls(bool ascending) {\r\n    // Sort calls by ascending or descending order\r\n    allCalls.sort((a, b) => ascending ? a.compareTo(b) : b.compareTo(a));\r\n  }\r\n}\r\n"}, {'file_path': 'chat_controller.dart', 'content': 'import \'package:get/get.dart\';\r\nimport \'../models/chat_model.dart\';\r\nimport \'../models/chat_message.dart\';\r\n\r\nclass ChatController extends GetxController {\r\n  var chats = <ChatModel>[\r\n    ChatModel(\r\n      name: "Jane Doe",\r\n      messageTime: "3:14 pm",\r\n      profileImage: "assets/images/profile_image_2.jpg",\r\n      messages: [\r\n        ChatMessage(content: "Hello!", isSentByMe: true),\r\n        ChatMessage(content: "How are you?", isSentByMe: false),\r\n      ],\r\n    ),\r\n    ChatModel(\r\n      name: "John Doe",\r\n      messageTime: "3:14 pm",\r\n      profileImage: "assets/images/profile_image_2.jpg",\r\n      messages: [\r\n        ChatMessage(content: "Hi!", isSentByMe: false),\r\n        ChatMessage(content: "What\'s up?", isSentByMe: true),\r\n      ],\r\n    ),\r\n  ].obs;\r\n\r\n  var searchQuery = \'\'.obs;\r\n\r\n  void filterChats(String query) {\r\n    searchQuery.value = query;\r\n  }\r\n\r\n  void sortChatsByOldest() {\r\n    chats.sort((a, b) => a.messageTime.compareTo(b.messageTime));\r\n  }\r\n\r\n  void sortChatsByLatest() {\r\n    chats.sort((a, b) => b.messageTime.compareTo(a.messageTime));\r\n  }  \r\n      \r\n  // Current chat messages\r\n  var currentChatMessages = <ChatMessage>[].obs;\r\n\r\n  void loadChat(ChatModel chat) {\r\n    currentChatMessages.value = chat.messages;\r\n  }\r\n\r\n  void sendMessage(String message) {\r\n    if (message.isNotEmpty) {\r\n      currentChatMessages.add(ChatMessage(content: message, isSentByMe: true));\r\n    } else {\r\n      Get.snackbar(\'Error\', \'Message cannot be empty\');\r\n    }\r\n  }\r\n}\r\n'}, {'file_path': 'status_controller.dart', 'content': "import 'package:get/get.dart';\r\n\r\nclass StatusController extends GetxController {\r\n  var searchText = ''.obs;\r\n\r\n  void updateSearchText(String text) {\r\n    searchText.value = text;\r\n  }\r\n}"}, {'file_path': 'main.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport 'views/home_page.dart';\r\nimport 'views/status_screen.dart';\r\nimport 'views/call_screen.dart';\r\n\r\nvoid main() {\r\n  runApp(WhatsAppUI());\r\n}\r\n\r\nclass WhatsAppUI extends StatelessWidget {\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return GetMaterialApp(\r\n      theme: ThemeData.dark(),\r\n      initialRoute: '/',\r\n      getPages: [\r\n        GetPage(name: '/', page: () => HomePage()),\r\n        GetPage(name: '/status', page: () => StatusScreen()),\r\n        GetPage(name: '/calls', page: () => CallScreen()),\r\n      ],\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'call_model.dart', 'content': 'class CallData {\r\n  final String name;\r\n  final String date;\r\n  final String profileImage;\r\n  final String callStatusIcon;\r\n\r\n  CallData({\r\n    required this.name,\r\n    required this.date,\r\n    required this.profileImage,\r\n    required this.callStatusIcon,\r\n  });\r\n}\r\n'}, {'file_path': 'chat_message.dart', 'content': 'class ChatMessage {\r\n  final String content;\r\n  final bool isSentByMe;\r\n\r\n  ChatMessage({required this.content, required this.isSentByMe});\r\n}\r\n'}, {'file_path': 'chat_model.dart', 'content': "import 'package:get/get.dart';\r\nimport './chat_message.dart';\r\nclass ChatModel {\r\n  final String name;\r\n  final String messageTime;\r\n  final String profileImage;\r\n  final List<ChatMessage> messages;\r\n\r\n  ChatModel({\r\n    required this.name,\r\n    required this.messageTime,\r\n    required this.profileImage,\r\n    required this.messages,\r\n  });\r\n}\r\n"}, {'file_path': 'user_status.dart', 'content': 'class UserStatus {\r\n  final String imageUrl;\r\n  final String userName;\r\n  final String time;\r\n\r\n  UserStatus({required this.imageUrl, required this.userName, required this.time});\r\n}\r\n'}, {'file_path': 'app_constants.dart', 'content': "class AppConstants {\r\n  static const String appName = 'WhatsApp';\r\n  static const String recentUpdates = 'Recent updates';\r\n  static const String viewedUpdates = 'Viewed updates';\r\n}\r\n"}, {'file_path': 'constants.dart', 'content': "import 'package:flutter/material.dart';\r\n\r\nclass AppColors {\r\n  static const background = Color(0xFF121B22);\r\n  static const appBar = Color(0xFF1F2C34);\r\n  static const indicator = Color(0xFF00AF9C);\r\n  static const unselectedLabel = Color(0xFF9DA5AC);\r\n  static const fab = Color(0xFF00AF9C);\r\n}\r\n\r\nclass AppTextStyles {\r\n  static const appBarTitle = TextStyle(\r\n    fontFamily: 'HelveticaNeue',\r\n    fontSize: 20,\r\n    fontWeight: FontWeight.bold,\r\n    color: Color(0xFFD1DAE0),\r\n  );\r\n\r\n  static const tabLabel = TextStyle(\r\n    fontFamily: 'HelveticaNeue',\r\n    fontSize: 14,\r\n    fontWeight: FontWeight.bold,\r\n  );\r\n\r\n  static const tabCounter = TextStyle(\r\n    fontSize: 12,\r\n    fontWeight: FontWeight.bold,\r\n    color: Color(0xFF1F2C34),\r\n  );\r\n\r\n  static const chatName = TextStyle(\r\n    fontFamily: 'HelveticaNeue',\r\n    fontSize: 18,\r\n    fontWeight: FontWeight.bold,\r\n    color: Color(0xFFD3DAE0),\r\n  );\r\n\r\n  static const chatTime = TextStyle(\r\n    fontFamily: 'HelveticaNeue',\r\n    fontSize: 14,\r\n    color: Color(0xFF869194),\r\n  );\r\n}\r\n"}, {'file_path': 'utils.dart', 'content': "import 'package:flutter/material.dart';\r\n\r\nclass Utils {\r\n  static void showErrorMessage(BuildContext context, String message) {\r\n    // Display an error message using a SnackBar\r\n    ScaffoldMessenger.of(context).showSnackBar(\r\n      SnackBar(\r\n        content: Text(message),\r\n        backgroundColor: Colors.red,\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'calls_page.dart', 'content': "import 'package:flutter/material.dart';\r\nimport '../models/call_model.dart';\r\nimport '../controllers/call_controller.dart';\r\nimport 'package:get/get.dart';\r\nimport 'call_tile.dart';\r\n\r\nclass CallsPage extends StatelessWidget {\r\n  final CallController callController = Get.put(CallController());\r\n\r\n  CallsPage() {\r\n    callController.addCall('Jane Doe');\r\n  }\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Obx(\r\n      () => ListView(\r\n        children: callController.allCalls\r\n            .map((call) => CallTile(CallData(\r\n                  name: call,\r\n                  date: 'Yesterday, 10:55 am',\r\n                  profileImage: 'assets/images/profile_image_1.jpg',\r\n                  callStatusIcon: 'assets/icons/call_received.png',\r\n                )))\r\n            .toList(),\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'call_screen.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../controllers/call_controller.dart';\r\nimport '../widgets/shared_widgets.dart'; // Import the shared_widgets.dart\r\nimport 'calls_page.dart';\r\n\r\nclass CallScreen extends StatefulWidget {\r\n  @override\r\n  _CallScreenState createState() => _CallScreenState();\r\n}\r\n\r\nclass _CallScreenState extends State<CallScreen> with SingleTickerProviderStateMixin {\r\n  late TabController _tabController;\r\n  final CallController callController = Get.put(CallController());\r\n\r\n  @override\r\n  void initState() {\r\n    super.initState();\r\n    _tabController = TabController(length: 4, vsync: this);\r\n  }\r\n\r\n  @override\r\n  void dispose() {\r\n    _tabController.dispose();\r\n    super.dispose();\r\n  }\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Scaffold(\r\n      appBar: CustomAppBar(title: 'Calls', tabController: _tabController),\r\n      body: TabBarView(\r\n        controller: _tabController,\r\n        children: [\r\n          Center(child: Text('Camera Page')),\r\n          Center(child: Text('Chats Page')),\r\n          Center(child: Text('Status Page')),\r\n          CallsPage(),\r\n        ],\r\n      ),\r\n      floatingActionButton: FloatingActionButton(\r\n        onPressed: () {},\r\n        child: Icon(Icons.add_ic_call),\r\n        backgroundColor: Color(0xFF25D366),\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'call_tile.dart', 'content': "import 'package:flutter/material.dart';\r\nimport '../models/call_model.dart';\r\n\r\nclass CallTile extends StatelessWidget {\r\n  final CallData call;\r\n\r\n  CallTile(this.call);\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return ListTile(\r\n      contentPadding: EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),\r\n      leading: CircleAvatar(\r\n        radius: 25.0,\r\n        backgroundImage: AssetImage(call.profileImage),\r\n      ),\r\n      title: Text(call.name, style: TextStyle(color: Colors.white)),\r\n      subtitle: Row(\r\n        children: [\r\n          Icon(Icons.call_received, color: Color(0xFF00A884), size: 16),\r\n          SizedBox(width: 4),\r\n          Text(call.date, style: TextStyle(color: Colors.white70)),\r\n        ],\r\n      ),\r\n      trailing: Icon(Icons.call, color: Color(0xFF00A884)),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'chat_list_item.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../models/chat_model.dart';\r\nimport '../controllers/chat_controller.dart';\r\nimport 'chat_ui.dart';\r\nimport '../utils/constants.dart';\r\n\r\nclass ChatListItem extends StatelessWidget {\r\n  final ChatModel chatItem;\r\n\r\n  ChatListItem({required this.chatItem});\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    final ChatController chatController = Get.find();\r\n\r\n    return GestureDetector(\r\n      onTap: () {\r\n        chatController.loadChat(chatItem);\r\n        Get.to(() => ChatUI(chatName: chatItem.name));\r\n      },\r\n      child: Container(\r\n        color: AppColors.background,\r\n        child: Padding(\r\n          padding: const EdgeInsets.symmetric(vertical: 10.0, horizontal: 16.0),\r\n          child: Row(\r\n            children: [\r\n              CircleAvatar(\r\n                backgroundImage: AssetImage(chatItem.profileImage),\r\n                radius: 24,\r\n              ),\r\n              SizedBox(width: 16),\r\n              Expanded(\r\n                child: Column(\r\n                  crossAxisAlignment: CrossAxisAlignment.start,\r\n                  children: [\r\n                    Text(\r\n                      chatItem.name,\r\n                      style: AppTextStyles.chatName,\r\n                    ),\r\n                    SizedBox(height: 8),\r\n                  ],\r\n                ),\r\n              ),\r\n              Text(\r\n                chatItem.messageTime,\r\n                style: AppTextStyles.chatTime,\r\n              ),\r\n            ],\r\n          ),\r\n        ),\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'chat_ui.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../widgets/background_pattern.dart';\r\nimport '../widgets/message_input_field.dart';\r\nimport '../widgets/secure_message_notification.dart';\r\nimport '../controllers/chat_controller.dart';\r\nimport '../models/chat_message.dart';\r\n\r\nclass ChatUI extends StatelessWidget {\r\n  final ChatController chatController = Get.find<ChatController>();\r\n  final String chatName;\r\n\r\n  ChatUI({required this.chatName});\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Scaffold(\r\n      backgroundColor: const Color(0xFF0F1E25),\r\n      appBar: AppBar(\r\n        backgroundColor: const Color(0xFF0F1E25),\r\n        title: Row(\r\n          children: [\r\n            CircleAvatar(\r\n              backgroundImage: AssetImage('assets/images/profile_image_1.png'),\r\n              radius: 16,\r\n            ),\r\n            const SizedBox(width: 10),\r\n            Text(\r\n              chatName,\r\n              style: const TextStyle(\r\n                color: Color.fromRGBO(211, 218, 224, 1),\r\n                fontSize: 21,\r\n                fontFamily: 'PT Sans',\r\n                fontWeight: FontWeight.normal,\r\n              ),\r\n            ),\r\n          ],\r\n        ),\r\n        actions: [\r\n          IconButton(\r\n            icon: const Icon(Icons.videocam),\r\n            color: Colors.white,\r\n            onPressed: () {\r\n              // TODO: Implement video call functionality\r\n            },\r\n          ),\r\n          IconButton(\r\n            icon: const Icon(Icons.call),\r\n            color: Colors.white,\r\n            onPressed: () {\r\n              // TODO: Implement voice call functionality\r\n            },\r\n          ),\r\n          IconButton(\r\n            icon: const Icon(Icons.more_vert),\r\n            color: Colors.white,\r\n            onPressed: () {\r\n              // TODO: Implement menu/options functionality\r\n            },\r\n          ),\r\n        ],\r\n      ),\r\n      body: Stack(\r\n        children: [\r\n          BackgroundPattern(),\r\n          Column(\r\n            children: [\r\n              SecureMessageNotification(),\r\n              Expanded(child: Obx(() {\r\n                var messages = chatController.currentChatMessages;\r\n                return ListView.builder(\r\n                  itemCount: messages.length,\r\n                  itemBuilder: (context, index) {\r\n                    ChatMessage message = messages[index];\r\n                    return ListTile(\r\n                      title: Align(\r\n                        alignment: message.isSentByMe ? Alignment.centerRight : Alignment.centerLeft,\r\n                        child: Container(\r\n                          padding: EdgeInsets.all(8.0),\r\n                          decoration: BoxDecoration(\r\n                            color: message.isSentByMe ? Colors.green : Colors.grey[700],\r\n                            borderRadius: BorderRadius.circular(8.0),\r\n                          ),\r\n                          child: Text(message.content, style: TextStyle(color: Colors.white)),\r\n                        ),\r\n                      ),\r\n                    );\r\n                  },\r\n                );\r\n              })),\r\n              const MessageInputField(),\r\n            ],\r\n          ),\r\n        ],\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'data_search.dart', 'content': 'import \'package:flutter/material.dart\';\r\nimport \'package:get/get.dart\';\r\nimport \'../controllers/call_controller.dart\';\r\n\r\nclass DataSearch extends SearchDelegate<String> {\r\n  final CallController callController = Get.find();\r\n\r\n  @override\r\n  List<Widget> buildActions(BuildContext context) {\r\n    return [\r\n      IconButton(\r\n        icon: Icon(Icons.clear),\r\n        onPressed: () {\r\n          query = "";\r\n        },\r\n      ),\r\n    ];\r\n  }\r\n\r\n  @override\r\n  Widget buildLeading(BuildContext context) {\r\n    return IconButton(\r\n      icon: AnimatedIcon(\r\n        icon: AnimatedIcons.menu_arrow,\r\n        progress: transitionAnimation,\r\n      ),\r\n      onPressed: () {\r\n        close(context, "");\r\n      },\r\n    );\r\n  }\r\n\r\n  @override\r\n  Widget buildResults(BuildContext context) {\r\n    final suggestionList = callController.allCalls.where((p) => p.startsWith(query)).toList();\r\n\r\n    return ListView.builder(\r\n      itemBuilder: (context, index) => ListTile(\r\n        onTap: () {\r\n          close(context, suggestionList[index]);\r\n        },\r\n        leading: Icon(Icons.person),\r\n        title: RichText(\r\n          text: TextSpan(\r\n            text: suggestionList[index].substring(0, query.length),\r\n            style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold),\r\n            children: [\r\n              TextSpan(\r\n                text: suggestionList[index].substring(query.length),\r\n                style: TextStyle(color: Colors.grey),\r\n              ),\r\n            ],\r\n          ),\r\n        ),\r\n      ),\r\n      itemCount: suggestionList.length,\r\n    );\r\n  }\r\n\r\n  @override\r\n  Widget buildSuggestions(BuildContext context) {\r\n    final suggestionList = query.isEmpty ? callController.recentCalls : callController.allCalls.where((p) => p.startsWith(query)).toList();\r\n\r\n    return ListView.builder(\r\n      itemBuilder: (context, index) => ListTile(\r\n        onTap: () {\r\n          query = suggestionList[index];\r\n          showResults(context);\r\n        },\r\n        leading: Icon(Icons.person),\r\n        title: RichText(\r\n          text: TextSpan(\r\n            text: suggestionList[index].substring(0, query.length),\r\n            style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold),\r\n            children: [\r\n              TextSpan(\r\n                text: suggestionList[index].substring(query.length),\r\n                style: TextStyle(color: Colors.grey),\r\n              ),\r\n            ],\r\n          ),\r\n        ),\r\n      ),\r\n      itemCount: suggestionList.length,\r\n    );\r\n  }\r\n}\r\n'}, {'file_path': 'home_page.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../controllers/chat_controller.dart';\r\nimport '../widgets/shared_widgets.dart';\r\nimport '../utils/constants.dart';\r\nimport 'chat_list_item.dart';\r\n\r\nclass HomePage extends StatefulWidget {\r\n  @override\r\n  _HomePageState createState() => _HomePageState();\r\n}\r\n\r\nclass _HomePageState extends State<HomePage> with SingleTickerProviderStateMixin {\r\n  final ChatController chatController = Get.put(ChatController());\r\n  late TabController _tabController;\r\n\r\n  @override\r\n  void initState() {\r\n    super.initState();\r\n    _tabController = TabController(length: 4, vsync: this);\r\n  }\r\n\r\n  @override\r\n  void dispose() {\r\n    _tabController.dispose();\r\n    super.dispose();\r\n  }\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Scaffold(\r\n      backgroundColor: AppColors.background,\r\n      appBar: CustomAppBar(title: 'WhatsApp', tabController: _tabController),\r\n      body: Column(\r\n        children: [\r\n          Expanded(child: Obx(() => _buildChatList())),\r\n        ],\r\n      ),\r\n      floatingActionButton: _buildFAB(),\r\n    );\r\n  }\r\n\r\n  Widget _buildChatList() {\r\n    return ListView.builder(\r\n      itemCount: chatController.chats.length,\r\n      itemBuilder: (context, index) {\r\n        return ChatListItem(chatItem: chatController.chats[index]);\r\n      },\r\n    );\r\n  }\r\n\r\n  FloatingActionButton _buildFAB() {\r\n    return FloatingActionButton(\r\n      backgroundColor: AppColors.fab,\r\n      onPressed: () {},\r\n      child: Icon(Icons.chat, color: Colors.white),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'status_screen.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../controllers/status_controller.dart';\r\nimport '../widgets/shared_widgets.dart';\r\nimport './status_tab.dart';\r\n\r\nclass StatusScreen extends StatefulWidget {\r\n  @override\r\n  _StatusScreenState createState() => _StatusScreenState();\r\n}\r\n\r\nclass _StatusScreenState extends State<StatusScreen> with SingleTickerProviderStateMixin {\r\n  late TabController _tabController;\r\n  final StatusController statusController = Get.put(StatusController());\r\n\r\n  @override\r\n  void initState() {\r\n    super.initState();\r\n    _tabController = TabController(length: 4, vsync: this);\r\n  }\r\n\r\n  @override\r\n  void dispose() {\r\n    _tabController.dispose();\r\n    super.dispose();\r\n  }\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Scaffold(\r\n      appBar: CustomAppBar(title: 'WhatsApp', tabController: _tabController),\r\n      body: StatusTab(),\r\n      floatingActionButton: Column(\r\n        mainAxisAlignment: MainAxisAlignment.end,\r\n        children: <Widget>[\r\n          FloatingActionButton(\r\n            onPressed: () {\r\n              ScaffoldMessenger.of(context).showSnackBar(\r\n                SnackBar(content: Text('Edit status')),\r\n              );\r\n            },\r\n            child: Icon(Icons.edit),\r\n            backgroundColor: Color(0xFFB2BEB5),\r\n          ),\r\n          SizedBox(height: 16),\r\n          FloatingActionButton(\r\n            onPressed: () {\r\n              ScaffoldMessenger.of(context).showSnackBar(\r\n                SnackBar(content: Text('Add new status')),\r\n              );\r\n            },\r\n            child: Icon(Icons.camera_alt),\r\n            backgroundColor: Color(0xFF25D366),\r\n          ),\r\n        ],\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'status_tab.dart', 'content': "import 'package:flutter/material.dart';\r\nimport '../models/user_status.dart';\r\nimport 'user_status_item.dart';\r\n\r\nclass StatusTab extends StatelessWidget {\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return ListView(\r\n      children: <Widget>[\r\n        ListTile(\r\n          contentPadding: EdgeInsets.symmetric(horizontal: 16, vertical: 8),\r\n          leading: Stack(\r\n            children: [\r\n              CircleAvatar(\r\n                radius: 25,\r\n                backgroundImage: AssetImage('assets/images/profile_image_2.jpg'),\r\n              ),\r\n              Positioned(\r\n                bottom: 0,\r\n                right: 0,\r\n                child: Container(\r\n                  decoration: BoxDecoration(\r\n                    shape: BoxShape.circle,\r\n                    color: Theme.of(context).colorScheme.secondary,  // Use colorScheme.secondary instead of accentColor\r\n                  ),\r\n                  child: Icon(Icons.add, size: 20, color: Colors.white),\r\n                ),\r\n              ),\r\n            ],\r\n          ),\r\n          title: Text('My status'),\r\n          subtitle: Text('Yesterday, 10:55 am'),\r\n          trailing: Icon(Icons.more_vert),\r\n        ),\r\n        sectionHeader('Recent updates'),\r\n        UserStatusItem(\r\n          status: UserStatus(\r\n            imageUrl: 'assets/images/profile_image_3.jpg',\r\n            userName: 'Jane Doe',\r\n            time: '30 minutes ago',\r\n          ),\r\n        ),\r\n        UserStatusItem(\r\n          status: UserStatus(\r\n            imageUrl: 'assets/images/profile_image_4.jpeg',\r\n            userName: 'John Doe',\r\n            time: '30 minutes ago',\r\n          ),\r\n        ),\r\n        sectionHeader('Viewed updates'),\r\n        UserStatusItem(\r\n          status: UserStatus(\r\n            imageUrl: 'assets/images/profile_image_5.jpeg',\r\n            userName: 'Jane Doe',\r\n            time: '30 minutes ago',\r\n          ),\r\n        ),\r\n        UserStatusItem(\r\n          status: UserStatus(\r\n            imageUrl: 'assets/images/profile_image_6.jpg',\r\n            userName: 'John Doe',\r\n            time: '30 minutes ago',\r\n          ),\r\n        ),\r\n      ],\r\n    );\r\n  }\r\n\r\n  Widget sectionHeader(String title) {\r\n    return Padding(\r\n      padding: const EdgeInsets.fromLTRB(16, 8, 0, 8),\r\n      child: Text(\r\n        title,\r\n        style: TextStyle(\r\n          fontWeight: FontWeight.bold,\r\n          color: Colors.grey,\r\n        ),\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'user_status_item.dart', 'content': "import 'package:flutter/material.dart';\r\nimport '../models/user_status.dart';\r\n\r\nclass UserStatusItem extends StatelessWidget {\r\n  final UserStatus status;\r\n\r\n  UserStatusItem({required this.status});\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Column(\r\n      children: <Widget>[\r\n        ListTile(\r\n          contentPadding: EdgeInsets.symmetric(horizontal: 16, vertical: 8),\r\n          leading: CircleAvatar(\r\n            radius: 25,\r\n            backgroundImage: AssetImage(status.imageUrl),\r\n          ),\r\n          title: Text(status.userName),\r\n          subtitle: Text(status.time),\r\n        ),\r\n        Divider(\r\n          indent: 72,\r\n          endIndent: 16,\r\n          height: 1,\r\n        ),\r\n      ],\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'background_pattern.dart', 'content': "import 'package:flutter/material.dart';\r\n\r\nclass BackgroundPattern extends StatelessWidget {\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Positioned.fill(\r\n      child: Image.asset(\r\n        'assets/images/whatsapp_background.jpg',\r\n        fit: BoxFit.cover,\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'custom_search_delegate.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../controllers/chat_controller.dart';\r\nimport '../models/chat_model.dart';\r\n\r\nclass CustomSearchDelegate extends SearchDelegate {\r\n  final ChatController chatController;\r\n\r\n  CustomSearchDelegate(this.chatController);\r\n\r\n  @override\r\n  List<Widget>? buildActions(BuildContext context) {\r\n    return [\r\n      IconButton(\r\n        icon: Icon(Icons.clear),\r\n        onPressed: () {\r\n          query = '';\r\n        },\r\n      ),\r\n    ];\r\n  }\r\n\r\n  @override\r\n  Widget? buildLeading(BuildContext context) {\r\n    return IconButton(\r\n      icon: Icon(Icons.arrow_back),\r\n      onPressed: () {\r\n        close(context, null);\r\n      },\r\n    );\r\n  }\r\n\r\n  @override\r\n  Widget buildResults(BuildContext context) {\r\n    var matchQuery = chatController.chats\r\n        .where((chat) => chat.name.toLowerCase().contains(query.toLowerCase()))\r\n        .toList();\r\n    return ListView.builder(\r\n      itemCount: matchQuery.length,\r\n      itemBuilder: (context, index) {\r\n        var result = matchQuery[index];\r\n        return ListTile(\r\n          title: Text(result.name),\r\n          subtitle: Text(result.messageTime),\r\n          leading: CircleAvatar(\r\n            backgroundImage: AssetImage(result.profileImage),\r\n          ),\r\n          onTap: () {\r\n            // TODO: Implement any actions on tap, if needed.\r\n          },\r\n        );\r\n      },\r\n    );\r\n  }\r\n\r\n  @override\r\n  Widget buildSuggestions(BuildContext context) {\r\n    var matchQuery = chatController.chats\r\n        .where((chat) => chat.name.toLowerCase().contains(query.toLowerCase()))\r\n        .toList();\r\n    return ListView.builder(\r\n      itemCount: matchQuery.length,\r\n      itemBuilder: (context, index) {\r\n        var result = matchQuery[index];\r\n        return ListTile(\r\n          title: Text(result.name),\r\n          subtitle: Text(result.messageTime),\r\n          leading: CircleAvatar(\r\n            backgroundImage: AssetImage(result.profileImage),\r\n          ),\r\n          onTap: () {\r\n            // TODO: Implement any actions on tap, if needed.\r\n          },\r\n        );\r\n      },\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'filter_modal.dart', 'content': "import 'package:flutter/material.dart';\r\n\r\nclass FilterModal extends StatelessWidget {\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Container(\r\n      color: Color(0xFF737373),\r\n      height: 160,\r\n      child: Container(\r\n        child: _buildFilterOptions(context),\r\n        decoration: BoxDecoration(\r\n          color: Colors.white,\r\n          borderRadius: BorderRadius.only(\r\n            topLeft: const Radius.circular(10),\r\n            topRight: const Radius.circular(10),\r\n          ),\r\n        ),\r\n      ),\r\n    );\r\n  }\r\n\r\n  Column _buildFilterOptions(BuildContext context) {\r\n    return Column(\r\n      children: <Widget>[\r\n        ListTile(\r\n          leading: Icon(Icons.access_time),\r\n          title: Text('Oldest'),\r\n          onTap: () {\r\n            Navigator.pop(context);\r\n          },\r\n        ),\r\n        ListTile(\r\n          leading: Icon(Icons.access_time),\r\n          title: Text('Latest'),\r\n          onTap: () {\r\n            Navigator.pop(context);\r\n          },\r\n        ),\r\n      ],\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'message_input_field.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../../controllers/chat_controller.dart';\r\n\r\nclass MessageInputField extends StatelessWidget {\r\n  const MessageInputField({Key? key}) : super(key: key);\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    final ChatController chatController = Get.find();\r\n    final TextEditingController _controller = TextEditingController();\r\n\r\n    return Container(\r\n      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 8),\r\n      color: const Color(0xFF1E2A31),\r\n      child: Row(\r\n        children: [\r\n          IconButton(\r\n            icon: const Icon(Icons.emoji_emotions, color: Colors.white),\r\n            onPressed: () {\r\n              // TODO: Implement emoji picker functionality\r\n            },\r\n          ),\r\n          Expanded(\r\n            child: TextField(\r\n              controller: _controller,\r\n              decoration: const InputDecoration(\r\n                hintText: 'Type a message',\r\n                hintStyle: TextStyle(\r\n                  color: Color.fromRGBO(112, 121, 128, 1),\r\n                  fontSize: 20,\r\n                  fontFamily: 'PT Sans',\r\n                  fontWeight: FontWeight.normal,\r\n                ),\r\n                border: InputBorder.none,\r\n              ),\r\n              style: const TextStyle(color: Colors.white),\r\n            ),\r\n          ),\r\n          GestureDetector(\r\n            onTap: () {\r\n              chatController.sendMessage(_controller.text);\r\n              _controller.clear();\r\n            },\r\n            child: CircleAvatar(\r\n              backgroundColor: const Color(0xFF02AF9C),\r\n              child: const Icon(\r\n                Icons.send,\r\n                color: Color(0xFFFAFFF7),\r\n              ),\r\n            ),\r\n          ),\r\n        ],\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'search_delegate.dart', 'content': "import 'package:flutter/material.dart';\r\nimport 'package:get/get.dart';\r\nimport '../controllers/status_controller.dart';\r\n\r\nclass DataSearch extends SearchDelegate<String> {\r\n  final StatusController statusController = Get.find();\r\n\r\n  @override\r\n  List<Widget> buildActions(BuildContext context) {\r\n    return [\r\n      IconButton(\r\n        icon: Icon(Icons.clear),\r\n        onPressed: () {\r\n          query = '';\r\n        },\r\n      ),\r\n    ];\r\n  }\r\n\r\n  @override\r\n  Widget buildLeading(BuildContext context) {\r\n    return IconButton(\r\n      icon: AnimatedIcon(\r\n        icon: AnimatedIcons.menu_arrow,\r\n        progress: transitionAnimation,\r\n      ),\r\n      onPressed: () {\r\n        close(context, '');\r\n      },\r\n    );\r\n  }\r\n\r\n  @override\r\n  Widget buildResults(BuildContext context) {\r\n    var matchQuery = [].where((chat) => chat.toLowerCase().contains(query.toLowerCase())).toList();\r\n    return ListView.builder(\r\n      itemCount: matchQuery.length,\r\n      itemBuilder: (context, index) {\r\n        var result = matchQuery[index];\r\n        return ListTile(\r\n          title: Text(result),\r\n          onTap: () {},\r\n        );\r\n      },\r\n    );\r\n  }\r\n\r\n  @override\r\n  Widget buildSuggestions(BuildContext context) {\r\n    var suggestionList = [].where((chat) => chat.toLowerCase().startsWith(query.toLowerCase())).toList();\r\n    return ListView.builder(\r\n      itemCount: suggestionList.length,\r\n      itemBuilder: (context, index) {\r\n        var result = suggestionList[index];\r\n        return ListTile(\r\n          title: RichText(\r\n            text: TextSpan(\r\n              text: result.substring(0, query.length),\r\n              style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold),\r\n              children: [\r\n                TextSpan(\r\n                  text: result.substring(query.length),\r\n                  style: TextStyle(color: Colors.grey),\r\n                ),\r\n              ],\r\n            ),\r\n          ),\r\n        );\r\n      },\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'secure_message_notification.dart', 'content': "import 'package:flutter/material.dart';\r\n\r\nclass SecureMessageNotification extends StatelessWidget {\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Container(\r\n      color: const Color.fromRGBO(30, 42, 49, 1),\r\n      padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 16),\r\n      child: Row(\r\n        crossAxisAlignment: CrossAxisAlignment.start,\r\n        children: [\r\n          Icon(Icons.lock, color: Color.fromRGBO(199, 190, 138, 1)),\r\n          SizedBox(width: 8),\r\n          Expanded(\r\n            child: Text(\r\n              'Messages and calls are end-to-end encrypted. No one outside of this chat, not even WhatsApp, can read or listen to them. Tap to learn more.',\r\n              style: TextStyle(\r\n                color: Color.fromRGBO(199, 190, 138, 1),\r\n                fontSize: 12,\r\n                fontFamily: 'PT Sans',\r\n                fontWeight: FontWeight.normal,\r\n              ),\r\n            ),\r\n          ),\r\n        ],\r\n      ),\r\n    );\r\n  }\r\n}\r\n"}, {'file_path': 'shared_widgets.dart', 'content': 'import \'package:flutter/material.dart\';\r\nimport \'package:get/get.dart\';\r\nimport \'../controllers/chat_controller.dart\';\r\nimport \'../utils/constants.dart\';\r\nimport \'../widgets/custom_search_delegate.dart\';\r\n\r\nclass CustomAppBar extends StatelessWidget implements PreferredSizeWidget {\r\n  final String title;\r\n  final TabController tabController;\r\n\r\n  CustomAppBar({required this.title, required this.tabController});\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return AppBar(\r\n      backgroundColor: AppColors.appBar,\r\n      elevation: 0,\r\n      title: Text(\r\n        title,\r\n        style: AppTextStyles.appBarTitle,\r\n      ),\r\n      actions: [\r\n        IconButton(\r\n          icon: Icon(Icons.search),\r\n          onPressed: () {\r\n            showSearch(\r\n              context: context,\r\n              delegate: CustomSearchDelegate(Get.find<ChatController>()),\r\n            );\r\n          },\r\n        ),\r\n        PopupMenuButton(\r\n          onSelected: (value) {\r\n            if (value == \'Filter\') {\r\n              _filterChats(context); // Pass context here\r\n            }\r\n          },\r\n          itemBuilder: (context) => [\r\n            PopupMenuItem(\r\n              value: \'Filter\',\r\n              child: Text("Filter"),\r\n            ),\r\n          ],\r\n        ),\r\n      ],\r\n      bottom: CustomTabBar(tabController: tabController),\r\n    );\r\n  }\r\n\r\n  void _filterChats(BuildContext context) {\r\n    showModalBottomSheet(\r\n      context: context,\r\n      builder: (BuildContext context) {\r\n        return Container(\r\n          height: 150,\r\n          child: Column(\r\n            children: <Widget>[\r\n              ListTile(\r\n                title: Text(\'Oldest\'),\r\n                onTap: () {\r\n                  Get.find<ChatController>().sortChatsByOldest();\r\n                  Navigator.pop(context);\r\n                },\r\n              ),\r\n              ListTile(\r\n                title: Text(\'Latest\'),\r\n                onTap: () {\r\n                  Get.find<ChatController>().sortChatsByLatest();\r\n                  Navigator.pop(context);\r\n                },\r\n              ),\r\n            ],\r\n          ),\r\n        );\r\n      },\r\n    );\r\n  }\r\n\r\n  @override\r\n  Size get preferredSize => Size.fromHeight(kToolbarHeight + kTextTabBarHeight);\r\n}\r\n\r\nclass CustomTabBar extends StatelessWidget implements PreferredSizeWidget {\r\n  final TabController tabController;\r\n\r\n  CustomTabBar({required this.tabController});\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return TabBar(\r\n      controller: tabController,\r\n      indicatorColor: AppColors.indicator,\r\n      labelColor: AppColors.indicator,\r\n      unselectedLabelColor: AppColors.unselectedLabel,\r\n      labelStyle: AppTextStyles.tabLabel,\r\n      onTap: (index) {\r\n        if (index == 3) {\r\n          // Navigate to StatusScreen when STATUS tab is tapped\r\n          Get.toNamed(\'/calls\');\r\n        }\r\n        else if (index == 2) {\r\n          // Navigate to StatusScreen when STATUS tab is tapped\r\n          Get.toNamed(\'/status\');\r\n        } else if (index == 1) {\r\n          // Navigate to ChatsScreen when CHATS tab is tapped\r\n          Get.toNamed(\'/\');\r\n        } else {\r\n          // Keep the normal behavior for the other tabs\r\n          tabController.animateTo(index);\r\n        }\r\n      },\r\n      tabs: [\r\n        Tab(icon: Icon(Icons.camera_alt)),\r\n        Tab(\r\n          child: Row(\r\n            mainAxisSize: MainAxisSize.min,\r\n            children: [\r\n              Text(\'CHATS\'),\r\n              SizedBox(width: 8),\r\n              Container(\r\n                padding: EdgeInsets.symmetric(vertical: 1, horizontal: 6),\r\n                decoration: BoxDecoration(\r\n                  color: Colors.white,\r\n                  borderRadius: BorderRadius.circular(12),\r\n                ),\r\n                child: Text(\r\n                  \'4\',\r\n                  style: AppTextStyles.tabCounter,\r\n                ),\r\n              ),\r\n            ],\r\n          ),\r\n        ),\r\n        Tab(text: \'STATUS\'),\r\n        Tab(text: \'CALLS\'),\r\n      ],\r\n    );\r\n  }\r\n\r\n  @override\r\n  Size get preferredSize => Size.fromHeight(kTextTabBarHeight);\r\n}\r\n'}, {'file_path': 'Readme.txt', 'content': '├── android/\n│   ├── app/\n│   │   ├── build.gradle\n│   │   └── src/\n│   │       ├── main/\n│   │       │   ├── AndroidManifest.xml\n│   │       │   ├── java/\n│   │       │   │   └── io/\n│   │       │   │       └── flutter/\n│   │       │   │           └── plugins/\n│   │       │   │               └── GeneratedPluginRegistrant.java\n│   │       │   ├── kotlin/\n│   │       │   │   └── com/\n│   │       │   │       └── example/\n│   │       │   │           └── myapp/\n│   │       │   │               └── MainActivity.kt\n│   │       │   └── res/\n│   │       │       ├── drawable/\n│   │       │       │   └── launch_background.xml\n│   │       │       ├── drawable-v21/\n│   │       │       │   └── launch_background.xml\n│   │       │       ├── mipmap-hdpi/\n│   │       │       ├── mipmap-mdpi/\n│   │       │       ├── mipmap-xhdpi/\n│   │       │       ├── mipmap-xxhdpi/\n│   │       │       ├── mipmap-xxxhdpi/\n│   │       │       ├── values/\n│   │       │       │   └── styles.xml\n│   │       │       └── values-night/\n│   │       │           └── styles.xml\n│   │       └── profile/\n│   │           └── AndroidManifest.xml\n│   ├── build.gradle\n│   ├── gradle/\n│   │   └── wrapper/\n│   ├── gradlew\n│   └── settings.gr